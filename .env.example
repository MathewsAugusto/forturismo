# =========================================================================
# ForTurismo — Variáveis de Ambiente de Produção & Desenvolvimento
# Copie este arquivo para .env.local e preencha com as suas chaves
# =========================================================================

# --- 1. SUPABASE (PostgreSQL, Auth e Row Level Security) ---
# Obtenha em: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://sua-instancia.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_publica_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_secreta_aqui

# --- 2. NOTIFICAÇÕES WHATSAPP API (Disparo de Alertas e OTP) ---
# Exemplo com provedor de mensageria WhatsApp (Z-API, Evolution API ou Cloud API Meta)
WHATSAPP_API_URL=https://api.provedor-whatsapp.com/send
WHATSAPP_API_TOKEN=seu_token_api_whatsapp
WHATSAPP_INSTANCE_ID=instancia_forturismo

# --- 3. E-MAIL TRANSACIONAL (Resend ou SendGrid) ---
# Obtenha em: https://resend.com/api-keys
RESEND_API_KEY=re_123456789
CONCIERGE_NOTIFICATION_EMAIL=concierge@forturismo.com
